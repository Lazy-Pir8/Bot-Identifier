# ─── Reddit API Credentials ──────────────────────────────────────────
# Create your app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=reddit-bot-identifier/1.0 by u/your_username

# ─── Database ────────────────────────────────────────────────────────
# For SQLite (default, no setup needed):
DB_PATH=./data/botdb.sqlite
# For PostgreSQL (optional, for scale):
# DATABASE_URL=postgresql://user:password@localhost:5432/botdb

# ─── Scoring Weights (must sum to 1.0) ───────────────────────────────
WEIGHT_META=0.25
WEIGHT_TEMPORAL=0.25
WEIGHT_LINGUISTIC=0.30
WEIGHT_NETWORK=0.20

# ─── Detection Thresholds ────────────────────────────────────────────
BOT_SCORE_THRESHOLD=0.65        # Score above this → labeled BOT
SUSPECT_SCORE_THRESHOLD=0.40    # Score above this → labeled SUSPECT

# ─── Monitoring ──────────────────────────────────────────────────────
# Subreddits to monitor (comma-separated), or "all" for r/all
MONITOR_SUBREDDITS=all
# How many comment history items to pull (max Reddit allows: 1000)
MAX_COMMENT_HISTORY=100

